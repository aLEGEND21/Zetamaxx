# Copy to `.env` (repo root). Both apps read this one file. Never commit `.env`.
#
# This file is for development only. Production values can be kept in
# `.env.production` (gitignored), which nothing here reads; see README, "Deploy".

# --- Clerk -------------------------------------------------------------------
# Dev: keys from your Clerk *development* instance (pk_test_ / sk_test_).
# Prod: keys from the *production* instance (pk_live_ / sk_live_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Origins allowed in the session token's `azp` claim (comma separated).
# Dev: http://localhost:3000   Prod: https://zetamaxx.arnavm.com
ALLOWED_ORIGINS=http://localhost:3000

# --- Wiring ------------------------------------------------------------------
# Where Next.js forwards /api/*. Dev: http://localhost:8000. The production
# image build sets this itself.
# API_URL=http://localhost:8000

# SQLite file. Dev default is ./data/zetamaxx.db. Docker sets /data/zetamaxx.db.
# DATABASE_PATH=./data/zetamaxx.db

# --- Playwright end-to-end test only ------------------------------------------
# `make e2e` signs in as two users in the Clerk *development* instance and
# creates them on first run. Defaults are shown; override only if you want to
# use different accounts. Emails containing +clerk_test never receive real mail.
# E2E_USER_1=zetamaxx-e2e-1+clerk_test@example.com
# E2E_USER_2=zetamaxx-e2e-2+clerk_test@example.com
